body {
  font-family: sans-serif;
  max-width: 500px;
  margin: 40px auto;
  padding: 0 20px;
}

textarea {
  width: 100%;
  padding: 10px;
  font-size: 16px;
  box-sizing: border-box;
}

button {
  margin-top: 10px;
  padding: 8px 16px;
  cursor: pointer;
}

#lista-notas {
  list-style: none;
  padding: 0;
}

#lista-notas li {
  background: #f4f4f4;
  padding: 10px;
  margin-bottom: 8px;
  border-radius: 6px;
}