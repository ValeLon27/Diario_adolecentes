body {
  font-family: sans-serif;
  max-width: 500px;
  margin: 40px auto;
  padding: 0 20px;
}

textarea {
  width: 100%;
  padding: 10px;
  font-size: 16px;
  box-sizing: border-box;
}

button {
  margin-top: 10px;
  padding: 8px 16px;
  cursor: pointer;
}

#lista-notas {
  list-style: none;
  padding: 0;
}

#lista-notas li {
  background: #f4f4f4;
  padding: 10px;
  margin-bottom: 8px;
  border-radius: 6px;
}
select {
  width: 100%;
  padding: 8px;
  font-size: 15px;
  margin-bottom: 8px;
  border-radius: 6px;
}

#lista-notas li {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.badge-categoria {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 12px;
  font-size: 13px;
  font-weight: bold;
  width: fit-content;
  color: #1a1a1a;
}

#lista-notas li p {
  margin: 0;
}
.fila-nota {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.boton-candado {
  background: none;
  border: none;
  font-size: 18px;
  cursor: pointer;
  padding: 2px 6px;
}

.texto-oculto {
  font-style: italic;
  color: #888;
}